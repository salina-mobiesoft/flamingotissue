---
import Layout from '../layouts/Layout.astro';
import { teamMembers } from '../data/team';
---

<Layout
  title="Management - Flamingo"
  description="Meet the executive leadership team of Flamingo Paper Products, Inc. Leading with over 50 years of combined excellence in the paper products manufacturing industry."
>
  <div class="container page-container">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <li><a href="/">Home</a></li>
      <li class="breadcrumb-separator">/</li>
      <li class="breadcrumb-current" aria-current="page">Management</li>
    </nav>

    <div class="management-hero">
      <h1 class="page-title">Management</h1>
      <p class="lead-text">
        Our executive leadership team brings decades of specialized paper manufacturing, supply chain, financial, and international marketing expertise to Flamingo Paper Products, Inc.
      </p>
    </div>

    <div class="team-list">
      {teamMembers.map((member) => (
        <article class="team-card" aria-labelledby={`member-${member.name.toLowerCase().replace(/[^a-z0-9]/g, '-')}`}>
          <div class="member-image-wrapper">
            <img
              src={member.image}
              alt={member.isLogoImage ? `Flamingo Tissue - Executive Office` : member.name}
              width="200"
              height="200"
              class:list={["member-img", { "logo-img": member.isLogoImage }]}
              loading="lazy"
            />
          </div>

          <div class="member-details">
            <div class="member-header">
              <h2 id={`member-${member.name.toLowerCase().replace(/[^a-z0-9]/g, '-')}`} class="member-name">
                {member.name}
              </h2>
              <span class="member-separator">&mdash;</span>
              <span class="member-title">{member.title}</span>
            </div>
            <p class="member-bio">{member.bio}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>

<style>
  .page-container {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .management-hero {
    margin-bottom: 3rem;
  }

  .team-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .team-card {
    display: flex;
    gap: 2rem;
    align-items: center;
    background-color: #ffffff;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-sm);
    padding: 2rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .team-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary-pink);
  }

  .member-image-wrapper {
    width: 170px;
    height: 170px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: #f7f7f9;
    border: 1px solid rgba(0,0,0,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .member-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .member-img.logo-img {
    object-fit: contain;
    padding: 1rem;
  }

  .member-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .member-header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .member-name {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  .member-separator {
    color: var(--primary-pink);
    font-weight: 700;
  }

  .member-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--primary-dark-pink);
  }

  .member-bio {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .team-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
      gap: 1.25rem;
    }
    .member-image-wrapper {
      width: 140px;
      height: 140px;
      margin: 0 auto;
    }
    .member-header {
      flex-direction: column;
      gap: 0.25rem;
    }
    .member-separator {
      display: none;
    }
  }
</style>
