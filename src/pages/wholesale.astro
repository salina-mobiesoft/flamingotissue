---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Wholesale - Flamingo"
  description="Flamingo Paper Products wholesale inquiries, bulk ordering, distributor sales, and corporate inquiries."
>
  <div class="container page-container">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <li><a href="/">Home</a></li>
      <li class="breadcrumb-separator">/</li>
      <li class="breadcrumb-current" aria-current="page">Wholesale</li>
    </nav>

    <div class="wholesale-hero">
      <h1 class="page-title">Wholesale</h1>
      <p class="lead-text">
        Flamingo Paper Products provides competitive wholesale pricing, freight coordination, and volume discounts for retailers, institutional purchasers, lodging, and commercial distributors nationwide.
      </p>
    </div>

    <div class="wholesale-grid">
      <!-- Original Contact Box -->
      <div class="wholesale-card contact-card">
        <h2 class="card-title">EMAIL US</h2>
        <div class="email-entries">
          <div class="email-item">
            <span class="email-label">General Inquiries:</span>
            <a href="mailto:info@flamingotissue.com" class="email-link">info@flamingotissue.com</a>
          </div>
          <div class="email-item highlighted">
            <span class="email-label">Wholesale Sales Inquiries:</span>
            <a href="mailto:sales@flamingotissue.com" class="email-link">sales@flamingotissue.com</a>
          </div>
          <div class="email-item">
            <span class="email-label">Customer Support:</span>
            <a href="mailto:support@flamingotissue.com" class="email-link">support@flamingotissue.com</a>
          </div>
          <div class="email-item">
            <span class="email-label">Career Inquiries:</span>
            <a href="mailto:jobs@flamingotissue.com" class="email-link">jobs@flamingotissue.com</a>
          </div>
        </div>

        <div class="phone-box">
          <p><strong>Direct Sales Telephone:</strong></p>
          <a href="tel:888-580-8091" class="phone-link">888-580-8091</a>
        </div>
      </div>

      <!-- Wholesale Program Features -->
      <div class="wholesale-card info-card">
        <h2 class="card-title">Commercial Distribution Programs</h2>
        <ul class="program-list">
          <li>
            <strong>Pallet &amp; Truckload Ordering:</strong>
            Full truckload (FTL) and less-than-truckload (LTL) deliveries across North America with flexible scheduling.
          </li>
          <li>
            <strong>Hospitality &amp; Commercial Supply:</strong>
            Standard 12, 24, and 48 Super and Plus roll packs optimized for hotel chains, corporate offices, and property management.
          </li>
          <li>
            <strong>Retail &amp; Supermarket Readiness:</strong>
            High-impact retail packaging with scannable UPC codes and attractive shelf presence.
          </li>
          <li>
            <strong>Ecological Compliance:</strong>
            Septic-safe, biodegradable double-ply toilet tissue compliant with commercial plumbing standards.
          </li>
        </ul>
      </div>
    </div>

    <!-- Interactive Wholesale Inquiry Builder (No Database Needed) -->
    <div class="quote-request-section">
      <h2 class="section-title">Request a Wholesale Quote</h2>
      <p class="section-desc">Fill out your details below to instantly generate an email directly to our wholesale sales desk.</p>

      <form id="wholesale-quote-form" class="wholesale-form">
        <div class="form-row">
          <div class="form-group">
            <label for="w-name">Contact Name *</label>
            <input type="text" id="w-name" required placeholder="John Doe" class="form-input" />
          </div>
          <div class="form-group">
            <label for="w-company">Company / Organization *</label>
            <input type="text" id="w-company" required placeholder="Acme Distribution LLC" class="form-input" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="w-phone">Phone Number</label>
            <input type="tel" id="w-phone" placeholder="888-000-0000" class="form-input" />
          </div>
          <div class="form-group">
            <label for="w-product">Product Series of Interest *</label>
            <select id="w-product" class="form-input">
              <option value="Flamingo Super Rolls (750 Sheets - 12/24/48 Count)">Flamingo Super Rolls (750 Sheets)</option>
              <option value="Flamingo Plus Rolls (550 Sheets - 12/24/48 Count)">Flamingo Plus Rolls (550 Sheets)</option>
              <option value="Both Super and Plus Rolls (Full Assortment)">Both Super and Plus Rolls (Full Assortment)</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="w-volume">Estimated Volume</label>
            <select id="w-volume" class="form-input">
              <option value="1-5 Pallets">1 - 5 Pallets</option>
              <option value="6-15 Pallets">6 - 15 Pallets</option>
              <option value="Full Truckload (FTL)">Full Truckload (FTL)</option>
              <option value="Recurring Monthly Distribution">Recurring Monthly Distribution</option>
            </select>
          </div>
          <div class="form-group">
            <label for="w-zip">Destination ZIP / Postal Code *</label>
            <input type="text" id="w-zip" required placeholder="e.g. 91746" class="form-input" />
          </div>
        </div>

        <div class="form-group">
          <label for="w-notes">Additional Notes or Delivery Specifications</label>
          <textarea id="w-notes" rows="4" placeholder="Liftgate required, loading dock details, specific timeline, etc." class="form-input"></textarea>
        </div>

        <button type="submit" class="btn btn-primary submit-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
          Compose Wholesale Inquiry Email
        </button>
      </form>
    </div>
  </div>
</Layout>

<style>
  .page-container {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .wholesale-hero {
    margin-bottom: 2.5rem;
  }

  .wholesale-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .wholesale-card {
    background-color: #ffffff;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-sm);
    padding: 2.25rem;
  }

  .card-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--primary-pink);
  }

  .email-entries {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .email-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .email-item.highlighted {
    background-color: var(--primary-light-pink);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    border-left: 4px solid var(--primary-dark-pink);
  }

  .email-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: #444;
  }

  .email-link {
    font-size: 1.05rem;
    color: var(--primary-dark-pink);
    font-weight: 700;
    text-decoration: underline;
  }

  .email-link:hover {
    color: #000;
  }

  .phone-box {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(0,0,0,0.1);
  }

  .phone-link {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  .program-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .program-list li {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .program-list strong {
    display: block;
    color: var(--text-dark);
    margin-bottom: 0.2rem;
  }

  /* Form */
  .quote-request-section {
    background-color: #fafafa;
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: var(--radius-sm);
    padding: 2.5rem;
  }

  .section-title {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .section-desc {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .wholesale-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #333;
  }

  .form-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: var(--radius-sm);
    font-size: 1rem;
    background-color: #ffffff;
    transition: border-color 0.2s;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--primary-pink);
    box-shadow: 0 0 0 3px rgba(255, 97, 197, 0.2);
  }

  .submit-btn {
    align-self: flex-start;
    padding: 0.9rem 2rem;
    font-size: 1.05rem;
  }

  @media (max-width: 850px) {
    .wholesale-grid {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
    .submit-btn {
      width: 100%;
    }
  }
</style>

<script>
  function setupWholesaleForm() {
    const form = document.getElementById('wholesale-quote-form');
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('w-name') as HTMLInputElement)?.value || '';
      const company = (document.getElementById('w-company') as HTMLInputElement)?.value || '';
      const phone = (document.getElementById('w-phone') as HTMLInputElement)?.value || '';
      const product = (document.getElementById('w-product') as HTMLSelectElement)?.value || '';
      const volume = (document.getElementById('w-volume') as HTMLSelectElement)?.value || '';
      const zip = (document.getElementById('w-zip') as HTMLInputElement)?.value || '';
      const notes = (document.getElementById('w-notes') as HTMLTextAreaElement)?.value || '';

      const subject = encodeURIComponent(`Wholesale Quote Request - ${company} (${name})`);
      const body = encodeURIComponent(
`Flamingo Paper Products Wholesale Desk,

Please provide a wholesale quote based on the following specifications:

Contact Name: ${name}
Company: ${company}
Phone: ${phone}
Product Interest: ${product}
Estimated Volume: ${volume}
Destination ZIP: ${zip}

Additional Notes:
${notes}

Thank you,
${name}
${company}`
      );

      window.location.href = `mailto:support@flamingotissue.com?cc=sales@flamingotissue.com&subject=${subject}&body=${body}`;
    });
  }

  document.addEventListener('DOMContentLoaded', setupWholesaleForm);
</script>
