---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="My Account - Flamingo"
  description="Flamingo Tissue customer account portal, wholesale order tracking, re-ordering, and support."
>
  <div class="container page-container">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <li><a href="/">Home</a></li>
      <li class="breadcrumb-separator">/</li>
      <li class="breadcrumb-current" aria-current="page">My Account</li>
    </nav>

    <div class="account-hero">
      <h1 class="page-title">My Account Portal</h1>
      <p class="lead-text">
        Manage your commercial orders, check shipping tracking, or request invoice copies directly through our customer support desk.
      </p>
    </div>

    <div class="account-grid">
      <!-- Section: Order History -->
      <section class="account-card" id="orders">
        <div class="card-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line>
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </div>
        <h2>Order Tracking &amp; History</h2>
        <p>To check the transit status of an active pallet order or retrieve past invoices, email your PO or order number to our fulfillment team.</p>
        <a href="mailto:support@flamingotissue.com?subject=Order%20Status%20Lookup" class="btn btn-outline">
          Track Order: support@flamingotissue.com
        </a>
      </section>

      <!-- Section: Wish List / Re-orders -->
      <section class="account-card" id="wishlist">
        <div class="card-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </div>
        <h2>Repeat Orders &amp; Favorites</h2>
        <p>Keep your facility stocked with consistent delivery schedules. Set up bi-weekly or monthly automated replenishments for Super or Plus rolls.</p>
        <a href="/products" class="btn btn-outline">
          Browse Catalog
        </a>
      </section>

      <!-- Section: Newsletter -->
      <section class="account-card" id="newsletter">
        <div class="card-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <h2>Wholesale Newsletter</h2>
        <p>Stay informed about pulp market trends, seasonal volume promotions, and new product announcements.</p>
        <form id="newsletter-form" class="newsletter-inline-form">
          <input type="email" id="nl-email" required placeholder="Enter your business email" class="form-input" />
          <button type="submit" class="btn btn-primary">Subscribe</button>
        </form>
        <p id="nl-notice" class="nl-success-msg" style="display: none;">Thank you! Your email has been registered for promotions.</p>
      </section>
    </div>
  </div>
</Layout>

<style>
  .page-container {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .account-hero {
    margin-bottom: 3rem;
  }

  .account-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .account-card {
    background-color: #ffffff;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-sm);
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.2s, border-color 0.2s;
  }

  .account-card:hover {
    transform: translateY(-3px);
    border-color: var(--primary-pink);
    box-shadow: var(--shadow-md);
  }

  .card-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: var(--primary-light-pink);
    color: var(--primary-dark-pink);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .account-card h2 {
    font-size: 1.25rem;
    color: var(--text-dark);
    margin-bottom: 0.75rem;
  }

  .account-card p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
    flex-grow: 1;
  }

  .account-card .btn {
    width: 100%;
  }

  .newsletter-inline-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
  }

  .nl-success-msg {
    margin-top: 0.75rem !important;
    color: #059669 !important;
    font-weight: 600;
    font-size: 0.85rem !important;
  }

  @media (max-width: 900px) {
    .account-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function setupNewsletter() {
    const form = document.getElementById('newsletter-form');
    const notice = document.getElementById('nl-notice');
    if (!form || !notice) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = (document.getElementById('nl-email') as HTMLInputElement)?.value;
      if (email) {
        notice.style.display = 'block';
        window.location.href = `mailto:support@flamingotissue.com?subject=Newsletter%20Subscription&body=Please%20add%20${encodeURIComponent(email)}%20to%20the%20Flamingo%20Tissue%20newsletter%20list.`;
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupNewsletter);
</script>
