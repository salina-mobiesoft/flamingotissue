---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us - Flamingo"
  description="Contact Flamingo Tissue. Located at 15117 Salt Lake Avenue, City of Industry, CA 91746. Phone: 888-580-8091. Email: support@flamingotissue.com."
>
  <div class="container page-container">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <li><a href="/">Home</a></li>
      <li class="breadcrumb-separator">/</li>
      <li class="breadcrumb-current" aria-current="page">Contact Us</li>
    </nav>

    <div class="contact-hero">
      <h1 class="page-title">Contact Us</h1>
      <p class="lead-text">
        Have questions about our bathroom tissue products, wholesale ordering, or deliveries? Reach out to our customer support and sales teams today.
      </p>
    </div>

    <div class="contact-layout-grid">
      <!-- Original Location & Contact Details -->
      <div class="contact-info-card">
        <div class="info-block">
          <h2 class="block-title">Our Location</h2>
          <div class="location-details">
            <p class="company-name"><strong>Flamingo Tissue</strong></p>
            <p class="street-address">15117 Salt Lake Avenue</p>
            <p class="city-state-zip">City of Industry, CA 91746</p>
          </div>
        </div>

        <div class="info-block">
          <h2 class="block-title">Telephone</h2>
          <p class="phone-number">
            <a href="tel:888-580-8091">888-580-8091</a>
          </p>
          <p class="hours-note">Monday &ndash; Friday, 8:00 AM &ndash; 5:00 PM PST</p>
        </div>

        <div class="info-block highlighted">
          <h2 class="block-title">Customer Support Email</h2>
          <p class="email-address">
            <a href="mailto:support@flamingotissue.com" class="support-email-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              support@flamingotissue.com
            </a>
          </p>
          <p class="email-note">All support requests and inquiries are answered within 1 business day.</p>
        </div>

        <div class="info-block">
          <h2 class="block-title">Additional Departments</h2>
          <ul class="dept-list">
            <li><strong>Wholesale Sales:</strong> <a href="mailto:sales@flamingotissue.com">sales@flamingotissue.com</a></li>
            <li><strong>General Inquiries:</strong> <a href="mailto:info@flamingotissue.com">info@flamingotissue.com</a></li>
            <li><strong>Careers:</strong> <a href="mailto:jobs@flamingotissue.com">jobs@flamingotissue.com</a></li>
          </ul>
        </div>
      </div>

      <!-- Contact Message Form (Client-Side mailto - No Database) -->
      <div class="contact-form-card">
        <h2 class="form-card-title">Send Us a Message</h2>
        <p class="form-card-desc">
          Use the form below to compose your message directly to <a href="mailto:support@flamingotissue.com"><strong>support@flamingotissue.com</strong></a>.
        </p>

        <form id="contact-form" class="contact-form">
          <div class="form-row">
            <div class="form-group">
              <label for="c-name">Your Name *</label>
              <input type="text" id="c-name" required placeholder="Jane Doe" class="form-input" />
            </div>
            <div class="form-group">
              <label for="c-email">Your Email Address *</label>
              <input type="email" id="c-email" required placeholder="jane@example.com" class="form-input" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="c-phone">Phone Number</label>
              <input type="tel" id="c-phone" placeholder="888-580-8091" class="form-input" />
            </div>
            <div class="form-group">
              <label for="c-subject">Inquiry Subject *</label>
              <select id="c-subject" class="form-input">
                <option value="General Support Inquiry">General Support Inquiry</option>
                <option value="Product Availability & Ordering">Product Availability &amp; Ordering</option>
                <option value="Wholesale / Distributor Inquiry">Wholesale / Distributor Inquiry</option>
                <option value="Delivery Status & Tracking">Delivery Status &amp; Tracking</option>
                <option value="Returns & Exchanges">Returns &amp; Exchanges</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="c-message">Your Message *</label>
            <textarea id="c-message" rows="5" required placeholder="Please describe how we can help you..." class="form-input"></textarea>
          </div>

          <button type="submit" class="btn btn-primary submit-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
            Send to support@flamingotissue.com
          </button>
        </form>

        <div id="contact-status-notice" class="status-notice" style="display: none;">
          <p>Opening your email client to send your message to <strong>support@flamingotissue.com</strong>...</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-container {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .contact-hero {
    margin-bottom: 2.5rem;
  }

  .contact-layout-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 2.5rem;
  }

  /* Info Card */
  .contact-info-card {
    background-color: #ffffff;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-sm);
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .info-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .info-block.highlighted {
    background-color: var(--primary-light-pink);
    padding: 1.25rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(194,0,108,0.2);
  }

  .block-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 0.25rem;
  }

  .location-details p {
    font-size: 1rem;
    color: #4b5563;
    line-height: 1.6;
  }

  .phone-number a {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--primary-dark-pink);
  }

  .phone-number a:hover {
    text-decoration: underline;
  }

  .hours-note {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .support-email-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--primary-dark-pink);
    text-decoration: underline;
    word-break: break-all;
  }

  .email-note {
    font-size: 0.85rem;
    color: #666;
  }

  .dept-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.95rem;
    color: #4b5563;
  }

  .dept-list a {
    color: var(--primary-dark-pink);
    text-decoration: underline;
  }

  /* Form Card */
  .contact-form-card {
    background-color: #fafafa;
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: var(--radius-sm);
    padding: 2.25rem;
  }

  .form-card-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 0.5rem;
  }

  .form-card-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .form-card-desc a {
    color: var(--primary-dark-pink);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #374151;
  }

  .form-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: var(--radius-sm);
    font-size: 0.98rem;
    background-color: #ffffff;
    transition: border-color 0.2s;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--primary-pink);
    box-shadow: 0 0 0 3px rgba(255, 97, 197, 0.2);
  }

  .submit-btn {
    align-self: flex-start;
    padding: 0.85rem 1.75rem;
    font-size: 1.05rem;
  }

  .status-notice {
    margin-top: 1.5rem;
    padding: 1rem;
    background-color: #d1fae5;
    border: 1px solid #10b981;
    border-radius: var(--radius-sm);
    color: #065f46;
    font-size: 0.95rem;
  }

  @media (max-width: 850px) {
    .contact-layout-grid {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
    .submit-btn {
      width: 100%;
    }
  }
</style>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form');
    const notice = document.getElementById('contact-status-notice');
    if (!form) return;

    // Check URL params for product inquiry
    const urlParams = new URLSearchParams(window.location.search);
    const productParam = urlParams.get('product');
    if (productParam) {
      const subjectSelect = document.getElementById('c-subject') as HTMLSelectElement;
      const messageTextarea = document.getElementById('c-message') as HTMLTextAreaElement;
      if (subjectSelect) subjectSelect.value = 'Product Availability & Ordering';
      if (messageTextarea) messageTextarea.value = `Hello Flamingo Tissue Team,\n\nI am inquiring about ${productParam}. Please provide pricing, availability, and ordering details.\n\nThank you!`;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('c-name') as HTMLInputElement)?.value || '';
      const email = (document.getElementById('c-email') as HTMLInputElement)?.value || '';
      const phone = (document.getElementById('c-phone') as HTMLInputElement)?.value || '';
      const subject = (document.getElementById('c-subject') as HTMLSelectElement)?.value || 'Support Request';
      const message = (document.getElementById('c-message') as HTMLTextAreaElement)?.value || '';

      const mailSubject = encodeURIComponent(`[Flamingo Tissue Contact] ${subject} - from ${name}`);
      const mailBody = encodeURIComponent(
`Name: ${name}
Email: ${email}
Phone: ${phone}
Subject: ${subject}

Message:
${message}
`
      );

      if (notice) notice.style.display = 'block';

      window.location.href = `mailto:support@flamingotissue.com?subject=${mailSubject}&body=${mailBody}`;
    });
  }

  document.addEventListener('DOMContentLoaded', setupContactForm);
</script>
