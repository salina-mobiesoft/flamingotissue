<style>
  .page-container {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .legal-article {
    max-width: 900px;
    margin: 0 auto;
    background-color: #ffffff;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-sm);
    padding: 3rem;
  }

  .company-subheading {
    font-size: 1.25rem;
    color: var(--primary-dark-pink);
    margin-top: -0.5rem;
    margin-bottom: 2rem;
  }

  .notice-callout {
    background-color: #fef2f2;
    border-left: 4px solid var(--primary-pink);
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-sm);
    margin-bottom: 2.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #374151;
  }

  .legal-section {
    margin-bottom: 2rem;
  }

  .legal-section h3 {
    font-size: 1.2rem;
    color: var(--text-dark);
    margin-bottom: 0.75rem;
  }

  .legal-section p {
    font-size: 0.96rem;
    line-height: 1.75;
    color: #4b5563;
    margin-bottom: 1rem;
  }

  .legal-section a {
    color: var(--primary-dark-pink);
    text-decoration: underline;
    font-weight: 600;
  }

  .uppercase-text {
    font-size: 0.9rem !important;
    line-height: 1.7 !important;
    background-color: #f9fafb;
    padding: 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid #e5e7eb;
  }

  @media (max-width: 768px) {
    .legal-article {
      padding: 1.5rem;
    }
  }
</style>
