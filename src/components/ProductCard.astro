---
interface Props {
  product: {
    id: string;
    name: string;
    series: string;
    sheets: string;
    ply: string;
    count: number;
    image: string;
    description: string;
    features?: string[];
  };
}

const { product } = Astro.props;
---

<div class="product-card" id={product.id}>
  <div class="product-badge">{product.series}</div>
  <div class="product-image-wrapper">
    <img
      src={product.image}
      alt={product.name}
      width="200"
      height="200"
      class="product-image"
      loading="lazy"
    />
  </div>
  <div class="product-details">
    <h3 class="product-title">{product.name}</h3>
    <div class="product-meta">
      <span class="meta-tag">{product.sheets}</span>
      <span class="meta-tag">{product.ply}</span>
      <span class="meta-tag">{product.count} Rolls Pack</span>
    </div>
    <p class="product-description">{product.description}</p>
    
    {product.features && product.features.length > 0 && (
      <ul class="feature-bullets">
        {product.features.map((feat) => (
          <li>
            <svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            {feat}
          </li>
        ))}
      </ul>
    )}
  </div>
</div>

<style>
  .product-card {
    position: relative;
    background-color: #ffffff;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary-pink);
  }

  .product-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: var(--primary-light-pink);
    color: var(--primary-dark-pink);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    border: 1px solid rgba(194, 0, 108, 0.2);
  }

  .product-image-wrapper {
    width: 200px;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1rem;
    margin-bottom: 1.25rem;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-image {
    transform: scale(1.05);
  }

  .product-details {
    width: 100%;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 0.75rem;
    min-height: 2.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .meta-tag {
    background-color: #f3f4f6;
    color: #4b5563;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
  }

  .product-description {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    text-align: left;
    flex-grow: 1;
  }

  .feature-bullets {
    list-style: none;
    text-align: left;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px dashed rgba(0,0,0,0.1);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .feature-bullets li {
    font-size: 0.85rem;
    color: #444;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .check-icon {
    color: var(--primary-dark-pink);
    flex-shrink: 0;
  }
</style>
