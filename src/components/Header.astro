---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About Flamingo" },
  { href: "/wholesale", label: "Wholesale" },
  { href: "/mgt", label: "Management" },
  { href: "/faqs", label: "FAQ" },
  { href: "/products", label: "Products" },
  { href: "/contact-us", label: "Contact Us" }
];

const cleanPath = currentPath.replace(/\/$/, "") || "/";
---

<header class="site-header" role="banner">
  <div class="header-top-bar">
    <div class="container top-bar-content">
      <div class="top-announcement">
        <span>Premium Soft &amp; Strong Bathroom Tissue &bull; Septic Safe</span>
      </div>
      <div class="top-contact-direct">
        <a href="tel:888-580-8091" class="top-phone">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          888-580-8091
        </a>
        <span class="divider">|</span>
        <a href="mailto:support@flamingotissue.com" class="top-email">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          support@flamingotissue.com
        </a>
      </div>
    </div>
  </div>

  <div class="header-main container">
    <div class="brand-wrapper">
      <a href="/" class="brand-link" aria-label="Flamingo Tissue - Home">
        <img
          src="/flamingo-tissue-1500h.png"
          alt="Flamingo Tissue Logo"
          width="208"
          height="123"
          class="brand-logo"
          loading="eager"
        />
      </a>
    </div>

    <!-- Desktop Navigation Bar -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navItems.map((item) => {
          const isActive = cleanPath === item.href || (item.href !== "/" && cleanPath.startsWith(item.href));
          return (
            <li class="nav-item">
              <a
                href={item.href}
                class:list={["nav-link", { active: isActive }]}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Mobile Hamburger Button -->
    <button
      id="mobile-menu-toggle"
      class="mobile-toggle"
      aria-label="Open Navigation Menu"
      aria-expanded="false"
      aria-controls="mobile-menu-drawer"
    >
      <span class="sr-only">Toggle Menu</span>
      <svg class="hamburger-icon" width="28" height="28" viewBox="0 0 1024 1024" fill="currentColor" aria-hidden="true">
        <path d="M128 554.667h768c23.552 0 42.667-19.115 42.667-42.667s-19.115-42.667-42.667-42.667h-768c-23.552 0-42.667 19.115-42.667 42.667s19.115 42.667 42.667 42.667zM128 298.667h768c23.552 0 42.667-19.115 42.667-42.667s-19.115-42.667-42.667-42.667h-768c-23.552 0-42.667 19.115-42.667 42.667s19.115 42.667 42.667 42.667zM128 810.667h768c23.552 0 42.667-19.115 42.667-42.667s-19.115-42.667-42.667-42.667h-768c-23.552 0-42.667 19.115-42.667 42.667s19.115 42.667 42.667 42.667z"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-header">
      <a href="/" class="mobile-brand-link" tabindex="-1">
        <img
          src="/flamingo-tissue-1500h.png"
          alt="Flamingo Tissue"
          width="120"
          height="70"
          class="mobile-logo"
        />
      </a>
      <button
        id="mobile-menu-close"
        class="mobile-close-btn"
        aria-label="Close Navigation Menu"
      >
        <svg width="24" height="24" viewBox="0 0 1024 1024" fill="currentColor" aria-hidden="true">
          <path d="M810 274l-238 238 238 238-60 60-238-238-238 238-60-60 238-238-238-238 60-60 238 238 238-238z"/>
        </svg>
      </button>
    </div>

    <nav class="mobile-nav" aria-label="Mobile Navigation">
      <ul class="mobile-nav-list">
        {navItems.map((item) => {
          const isActive = cleanPath === item.href || (item.href !== "/" && cleanPath.startsWith(item.href));
          return (
            <li class="mobile-nav-item">
              <a
                href={item.href}
                class:list={["mobile-nav-link", { active: isActive }]}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="mobile-drawer-footer">
      <div class="mobile-contact-info">
        <p><strong>Flamingo Tissue</strong></p>
        <p>15117 Salt Lake Avenue<br/>City of Industry, CA 91746</p>
        <p><a href="tel:888-580-8091">Phone: 888-580-8091</a></p>
        <p><a href="mailto:support@flamingotissue.com">support@flamingotissue.com</a></p>
      </div>
      <div class="mobile-socials">
        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="social-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
          </svg>
        </a>
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    background-color: #ffffff;
    border-bottom: 1px solid rgba(25, 24, 24, 0.08);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }

  .header-top-bar {
    background-color: #f7f7f9;
    font-size: 0.85rem;
    color: var(--text-muted);
    border-bottom: 1px solid rgba(25, 24, 24, 0.06);
    padding: 0.35rem 0;
  }

  .top-bar-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .top-announcement {
    font-weight: 500;
    color: #444;
  }

  .top-contact-direct {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .top-phone, .top-email {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #333;
    font-weight: 500;
  }

  .top-phone:hover, .top-email:hover {
    color: var(--primary-dark-pink);
  }

  .divider {
    color: #ccc;
  }

  .header-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
    gap: 1.5rem;
  }

  .brand-wrapper {
    flex-shrink: 0;
  }

  .brand-logo {
    width: 190px;
    height: auto;
    max-height: 80px;
    object-fit: contain;
    transition: transform 0.2s ease;
  }

  .brand-logo:hover {
    transform: scale(1.02);
  }

  /* Desktop Menu Bar matching live site pink style */
  .desktop-nav {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    background-color: var(--primary-pink);
    border: 1px solid var(--border-pink);
    border-radius: var(--radius-sm);
    padding: 0.65rem 1.25rem;
    gap: 1.5rem;
    box-shadow: 0 2px 6px rgba(255, 97, 197, 0.25);
  }

  .nav-link {
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    letter-spacing: 0.01em;
    position: relative;
    transition: all 0.2s ease;
  }

  .nav-link:hover {
    background-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    text-shadow: 0 0 2px rgba(255,255,255,0.5);
  }

  .nav-link.active {
    background-color: #ffffff;
    color: var(--primary-dark-pink);
    font-weight: 700;
    box-shadow: 0 1px 4px rgba(0,0,0,0.15);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--primary-dark-pink);
    padding: 0.5rem;
    cursor: pointer;
    border-radius: var(--radius-sm);
  }

  .mobile-toggle:focus-visible {
    outline: 2px solid var(--primary-dark-pink);
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: #ffffff;
    z-index: 2000;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem;
    overflow-y: auto;
  }

  .mobile-drawer.open {
    display: flex;
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }

  .mobile-close-btn {
    background: none;
    border: none;
    color: var(--text-dark);
    padding: 0.5rem;
    cursor: pointer;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav-link {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-dark);
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  .mobile-nav-link:hover, .mobile-nav-link.active {
    background-color: var(--primary-pink);
    color: #ffffff;
  }

  .mobile-drawer-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(0,0,0,0.1);
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .mobile-contact-info p {
    margin-bottom: 0.4rem;
  }

  .mobile-socials {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  .social-icon {
    color: var(--primary-dark-pink);
    transition: opacity 0.2s;
  }

  .social-icon:hover {
    opacity: 0.8;
  }

  @media (max-width: 991px) {
    .nav-list {
      gap: 0.85rem;
      padding: 0.5rem 0.85rem;
    }
    .nav-link {
      font-size: 0.88rem;
      padding: 0.2rem 0.35rem;
    }
  }

  @media (max-width: 768px) {
    .top-announcement {
      display: none;
    }
    .top-bar-content {
      justify-content: center;
    }
    .desktop-nav {
      display: none;
    }
    .mobile-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .brand-logo {
      width: 140px;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const closeBtn = document.getElementById('mobile-menu-close');
    const drawer = document.getElementById('mobile-menu-drawer');

    if (!toggleBtn || !closeBtn || !drawer) return;

    function openMenu() {
      drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      toggleBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function closeMenu() {
      drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      toggleBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      toggleBtn.focus();
    }

    toggleBtn.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);

    // Escape key closes menu
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('open')) {
        closeMenu();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupMobileMenu);
</script>
